# Copy this file to .env and fill in your own values. .env is gitignored.

# Which LLM provider to use:
#   ollama           - free, runs locally via the Ollama app (default)
#   anthropic        - paid, higher quality; requires ANTHROPIC_API_KEY
#   snowflake_cortex - requires a Snowflake account; completion-only, no tool-calling
#                      support — see DECISIONS.md #20 before using it for an agent node
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama (optional; must already be pulled via `ollama pull <name>`)
OLLAMA_MODEL=llama3.1:8b

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional: a stronger/different judge model for evals/research_quality_eval.py,
# independent of LLM_PROVIDER above (see DECISIONS.md #18). Same values as
# LLM_PROVIDER. Leave unset to judge with whatever LLM_PROVIDER is set to.
JUDGE_LLM_PROVIDER=

# Optional: LangSmith tracing (https://smith.langchain.com — free tier available).
# Needs no code — LangChain/LangGraph auto-instrument once these are set.
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=support-triage

# Required to run the FastAPI backend (support_triage/api.py) — every route except
# /health needs this value in an X-API-Key header. Pick any non-guessable string.
API_KEY=

# Required when LLM_PROVIDER=snowflake_cortex (see DECISIONS.md #20 — this
# integration has not been run against a real account; code is unit-tested only).
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_CORTEX_MODEL=llama3.1-8b
