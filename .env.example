# Copy this file to .env and fill in your own values. .env is gitignored.

# Which LLM provider to use:
#   ollama           - free, runs locally via the Ollama app (default)
#   anthropic        - paid, higher quality; requires ANTHROPIC_API_KEY
#   snowflake_cortex - Phase 6 only, not yet implemented
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama (optional; must already be pulled via `ollama pull <name>`)
OLLAMA_MODEL=llama3.1:8b

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
